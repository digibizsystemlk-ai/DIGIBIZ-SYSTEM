{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/clients/chisathifamilyproducts",
        "destination": "/clients/chisathifamily",
        "type": 301
      },
      {
        "source": "/clients/chisathifamilyproducts/**",
        "destination": "/clients/chisathifamily",
        "type": 301
      },
      {
        "source": "/clients/chisathifamily/modules/**",
        "destination": "/clients/chisathifamily",
        "type": 301
      },
      {
        "source": "/clients/darshanamadawala",
        "destination": "/clients/madawalateashop",
        "type": 301
      },
      {
        "source": "/clients/darshanamadawala/**",
        "destination": "/clients/madawalateashop",
        "type": 301
      },
      {
        "source": "/clients/madawalateashop/modules/**",
        "destination": "/clients/madawalateashop",
        "type": 301
      },
      {
        "source": "/clients/madawalateashop/modules",
        "destination": "/clients/madawalateashop",
        "type": 301
      },
      {
        "source": "/clients/sathityrecentre/modules/**",
        "destination": "/clients/sathityrecentre",
        "type": 301
      },
      {
        "source": "/clients/spi_holdings/modules/**",
        "destination": "/clients/spi_holdings",
        "type": 301
      },
      {
        "source": "/clients/thusithajayasundara/modules/**",
        "destination": "/clients/thusithajayasundara",
        "type": 301
      },
      {
        "source": "/clients/delightbakers/modules/**",
        "destination": "/clients/delightbakers",
        "type": 301
      },
      {
        "source": "/auth/**",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/clients/chisathifamily",
        "destination": "/clients/chisathifamily/index.html"
      },
      {
        "source": "/clients/chisathifamily/**",
        "destination": "/clients/chisathifamily/index.html"
      },
      {
        "source": "/clients/sathityrecentre",
        "destination": "/clients/sathityrecentre/index.html"
      },
      {
        "source": "/clients/sathityrecentre/**",
        "destination": "/clients/sathityrecentre/index.html"
      },
      {
        "source": "/clients/madawalateashop",
        "destination": "/clients/madawalateashop/index.html"
      },
      {
        "source": "/clients/madawalateashop/**",
        "destination": "/clients/madawalateashop/index.html"
      },
      {
        "source": "/clients/thusithajayasundara",
        "destination": "/clients/thusithajayasundara/index.html"
      },
      {
        "source": "/clients/thusithajayasundara/**",
        "destination": "/clients/thusithajayasundara/index.html"
      },
      {
        "source": "/clients/spi_holdings",
        "destination": "/clients/spi_holdings/index.html"
      },
      {
        "source": "/clients/spi_holdings/**",
        "destination": "/clients/spi_holdings/index.html"
      },
      {
        "source": "/clients/delightbakers",
        "destination": "/clients/delightbakers/index.html"
      },
      {
        "source": "/clients/delightbakers/**",
        "destination": "/clients/delightbakers/index.html"
      },
      {
        "source": "/clients/delight_bakers",
        "destination": "/clients/delightbakers/index.html"
      },
      {
        "source": "/clients/delight_bakers/**",
        "destination": "/clients/delightbakers/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|woff|woff2|ttf|eot|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
